#include<stdio.h>
int main()
{
  int i,j,n,m,f[20][20],g[20][20],x,y;
  scanf("%d %d %d %d",&n,&m,&x,&y);
  for(i=1;i<=n;i++)
  {
        for(j=1;j<=m;j++)
        {
        f[i][j]=0;
        }
  }
  for (i=0;i<=n;i++)
  {
        for (j=0;j<=m;j++)
        {
        g[i][j]=0;
        }
  }
g[x][y]=1;
g[x-1][y-2]=1;
g[x+1][y-2]=1;
g[x-2][y-1]=1;
g[x+2][y-1]=1;
g[x-2][y+1]=1;
g[x+2][y+1]=1;
g[x-1][y+2]=1;
g[x+1][y+2]=1;
 for (i=1;i<=n;i++)
 {
    if(g[i][0]!=1) f[i][0]=1;
	else  for(;i<=n;i++)
		{
        f[i][0]=0;
		}
 }
    for(j=1;j<=m;j++)
    {
      if(g[0][j]!=1)f[0][j]=1;
      else for(;j<=m;j++)
		{
        f[0][j]=0;
		}
    }
 for(i=1;i<=n;i++)
 {
    for (j=1;j<=m;j++)
    {
      if(g[i][j]==0)
     {
      f[i][j]=f[i-1][j]+f[i][j-1];
     }
    }
 }
  printf("%d\n",f[n][m]);
  return 0;
}
