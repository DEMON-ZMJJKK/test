#include <stdio.h>
#include <stdlib.h>
int a, b;
int s3[100001][12];
int s4[100001][12];
int main()
{
    int i,j,n,max;
    while(scanf("%d",&n)!=EOF)
    {
        if(n==0)return 0;
        memset(s3,0,sizeof(s3));
        memset(s4,0,sizeof(s4));
        for(i=1;i<=n;i++)
        {
            scanf("%d%d",&a,&b);
            s3[b][a]++;
            if(i==1)
            {
                max=b;
            }
            else
            {
                if(max<b)
                {
                    max=b;
                }
            }
        }
        for(i=0;i<=10;i++)
        {
            s4[max][i]=s3[max][i];
        }
        for(i=max-1;i>=0;i--)
        {
            for(j=0;j<=10;j++)
            {
                if((j-1)>=0&&(j+1)<=10)
                {
                    max=s4[i+1][j];
                    if(s4[i+1][j-1]>max)
                    {
                        max=s4[i+1][j-1];
                    }
                    if(s4[i+1][j+1]>max)
                    {
                        max=s4[i+1][j+1];
                    }
                        s4[i][j]=s3[i][j]+max;
                }
                else if((j-1)>=0&&(j+1)>10)
                {
                    max=s4[i+1][j];
                    if(s4[i+1][j-1]>max)
                    {
                    max=s4[i+1][j-1];
                    }
                    s4[i][j]=s3[i][j]+max;
                }
                else if((j-1)<0&&(j+1)<=10)
                {
                    max=s4[i+1][j];
                    if(s4[i+1][j+1]>max)
                    {
                      max=s4[i+1][j+1];
                    }
                      s4[i][j]=s3[i][j]+max;  
                }
            }
        }
        printf("%d\n",s4[0][5]);
    }
    return 0;
}
