#include<stdio.h>
 
int f(int n,int m)
 
{
 
    if(m==0)return 1;
 
    else if(n==1)return 1;
 
    else if(m==n)return 1;
 
    else return f(n-1,m-1)+f(n-1,m);
 
}
 
int main()
 
{
 
    int N,n,m;
 
    scanf("%d",&N);
 
    while(N--)
 
    {
 
        scanf("%d%d",&n,&m);
 
        printf("%d\n",f(n,m));
 
    }
 
    return 0;
 
}
