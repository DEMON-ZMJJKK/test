#include<stdio.h>
 
struct goods
 
{
 
 int Wi,Pi;
 
}s[100],t;
 
int main()
 
{
 
    int n,i,j;
 
    scanf("%d",&n);
 
    for(i=0;i<n;i++)
 
    {
 
        scanf("%d",&s[i].Wi);
 
    }
 
    for(i=0;i<n;i++)
 
    {
 
        scanf("%d",&s[i].Pi);
 
    }
 
    for(i=0;i<n-1;i++)
 
    {
 
        for(j=0;j<n-1-i;j++)
 
        {
 
            if(s[j].Wi>s[j+1].Wi)
 
            {
 
                t=s[j+1];
 
                s[j+1]=s[j];
 
                s[j]=t;
 
            }
 
            else if(s[j].Wi==s[j+1].Wi)
 
            {
 
                if(s[j].Pi<s[j+1].Pi)
 
                {
 
                    t=s[j+1];
 
                    s[j+1]=s[j];
 
                    s[j]=t;
 
                }
 
            }
 
        }
 
    }
 
    for(i=0;i<n;i++)
 
    {
 
        printf("%d %d\n",s[i].Wi,s[i].Pi);
 
    }
 
    return 0;
 
}
