#include <stdio.h>
int a[900001];
int find(int l,int r,int k)
{
    int x=a[l],i=l,j=r;
    while(i<j)
    {
        while(a[j]>=x&&i<j)
        {j--;}
        a[i]=a[j];
        while(a[i]<=x&&i<j)
        {i++;}
        a[j]=a[i];
    }
    a[i]=x;
    if(i==k) return a[i];
    if(i>k)find(l,i-1,k);
    else find(i+1,r,k);
}
 
int main()
{
        int n,k,i;
        scanf("%d%d",&n,&k);
        for(i=0;i<n;i++)
        {
        scanf("%d",&a[i]);
        }
        printf("%d\n",find(0,n-1,k-1));
    return 0;
}
 
