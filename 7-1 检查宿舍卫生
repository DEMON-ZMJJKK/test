#include<stdio.h>
struct score
{
    int a[5];
};
int main(){
    int n,sum=0,i,j,count=0,max=-1;
    scanf("%d",&n);
    struct score b[100];
    for(j=0;j<n;j++){
        for(i=0;i<5;i++){
            scanf("%d",&b[j].a[i]);
        }
        sum=b[j].a[0]+b[j].a[1]+b[j].a[2]+b[j].a[3]+b[j].a[4];
        if(sum<85)
            count++;
        else
            if(max<sum)
                max=sum;
        sum=0;
    }
    if(count==n)
        printf("%d No",n);
    else
        printf("%d %d",count,max);
    return 0;
}
