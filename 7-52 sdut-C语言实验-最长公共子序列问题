#include<stdio.h>
#include<string.h>
#define N 501
int main()
{
    int i,j,len1,len2,c[N][N];
    char x[N],y[N];
    gets(x);
    gets(y);
    len1=strlen(x);
    len2=strlen(y);
    for(i=0;i<=len1;i++)
    {
        c[i][0]=0;
    }
    for(j=0;j<=len2;j++)
    {
        c[0][j]=0;
    }
    for(i=1;i<=len1;i++)
    {
        for(j=1;j<=len2;j++)
        {
            if(x[i-1]==y[j-1])c[i][j]=c[i-1][j-1]+1;
            else if(c[i-1][j]>c[i][j-1])c[i][j]=c[i-1][j];
            else c[i][j]=c[i][j-1];
        }
    }
    printf("%d\n",c[len1][len2]);
    return 0;
}
