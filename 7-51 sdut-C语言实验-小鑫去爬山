#include <stdio.h>
#include <stdlib.h>
int main()
{
    int n,i,j;
    int a[101][101],b[101][101];
    while(scanf("%d",&n)!=EOF)
    {
        for(i=1;i<=n;i++)
        {
            for(j=1;j<=i;j++)
            {
                scanf("%d",&a[i][j]);
            }
        }
        for(i=1;i<=n;i++)
        {
            b[n][i]=a[n][i];
        }
        for(i=n-1;i>=1;i--)
        {
            for(j=1;j<=i;j++)
            {
                if(b[i+1][j]<b[i+1][j+1])b[i][j]=b[i+1][j]+a[i][j];
                else b[i][j]=b[i+1][j+1]+a[i][j];
            }
        }
        printf("%d\n",b[1][1]);
    }
    return 0;
}
