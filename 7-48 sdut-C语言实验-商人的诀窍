#include <stdio.h>
struct
{
    int p,h;
    double x;
} a[10001],t;
void sort(int l,int r)
{
    t=a[l];
    int i=l,j=r;
    if(l>=r)return;
    while(i<j)
    {
        while(a[j].x<=t.x&&i<j)j--;
        a[i]=a[j];
        while(a[i].x>=t.x&&i<j)i++;
        a[j]=a[i];
    }
    a[i]=t;
    sort(l,i-1);
    sort(i+1,r);
}
int main()
{
    int m,n,i;
    double ans=0;
    while(scanf("%d %d",&n,&m)!=EOF&&m!=-1&&n!=-1)
    {
        for(i=0;i<m;i++)
        {
            scanf("%d%d",&a[i].h,&a[i].p);
            a[i].x=a[i].h*1.0/a[i].p*1.0;
        }
        sort(0,m-1);
        for(i=0;i<m;i++)
        {
            if(a[i].p<=n)
            {
                ans+=1.0*a[i].h;
                n-=a[i].p;
            }
            else
            {
                ans+=n*1.0*a[i].x;
                break;
            }
        }
        printf("%.3f\n",ans);
    }
    return 0;
}
