#include<stdio.h>
#include<string.h>
long long int s[40][40][40];
long long int f(int a,int b,int c)
{
 
      if(a<=0||b<=0||c<=0)return 1;
      else if(s[a][b][c]!=0)return s[a][b][c];
      else if(a>20||b>20||c>20)s[a][b][c]=f(20,20,20);
      else if(a<b&&b<c)s[a][b][c]=f(a,b,c-1)+f(a,b-1,c-1)-f(a,b-1,c);
      else  s[a][b][c]=f(a-1,b,c)+f(a-1,b-1,c)+f(a-1,b,c-1)-f(a-1,b-1,c-1);
      return s[a][b][c];
    }
 
int main()
{
    int a,b,c ;
    long long int sum;
    memset(s,0,sizeof(s));
    while(scanf("%d%d%d",&a,&b,&c)!=EOF)
    {
       sum=f(a,b,c);
       printf("%lld\n",sum);
    }
    return 0;
}
