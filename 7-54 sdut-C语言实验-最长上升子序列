#include<stdio.h>
int max(x,y){return x>y?x:y;}
int main()
{
	int i,j,n,k,a[10001],dp[10001]; 
	scanf("%d",&n);
	for(i=0;i<n;i++)
    {
		scanf("%d",&a[i]);
	}
    k=0;
	for(i=0;i<n;i++)
	{
		dp[i]=1;
		for(j=0;j<i;j++)
		{
			if(a[i]>a[j])
			{
				dp[i]=max(dp[i],dp[j]+1);
				if(dp[i]>dp[k])
				{  
					k=i;       
				}
			}
		}
	}
	printf("%d\n",dp[k]);
	return 0;
}
