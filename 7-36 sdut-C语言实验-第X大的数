#include<stdio.h>
int a[100000];
void sort(int l,int r)
{
    int key=a[l];
    int i=l,j=r;
    while(i<j)
    {
        while(i<j&&key>=a[j])j--;
        a[i]=a[j];
        while(i<j&&key<=a[i])i++;
        a[j]=a[i];
    }
    a[i]=key;
    if(l<r)
    {
        sort(l,i-1);
        sort(i+1,r);
    }
}
 
int main()
{
    int n,i,m;
    int x;
    while(scanf("%d",&n)!=EOF)
    {
        for(i=0;i<n;i++)
        {
        scanf("%d",&a[i]);
        }
        sort(0,n-1);
        scanf("%d",&m);
        while(m--)
        {
           scanf("%d",&x);
           printf("%d\n",a[x-1]);
        }
    }
    return 0;
}
