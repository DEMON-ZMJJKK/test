#include <stdio.h>
int main()
{
    int n;
    int a[10]={0},x;
    while(scanf("%d",&n)!=EOF)
    {
        int m=0,i=0;
        while(n--)
        {
            scanf("%d",&x);
            for(i=0;i<m;i++)
            {
              if(x<=a[i])
              {
                a[i]=x;
                break;
              }
            }
            if(i==m)a[m++]=x;
        }
        printf("%d\n",m);
    }
    return 0;
}
