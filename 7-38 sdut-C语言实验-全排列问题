#include<stdio.h>
 
void Swap(int *p,int *q)
 
{
 
    int temp=*p;
 
    *p=*q;
 
    *q=temp;
 
}
 
void circular_right(int a[],int left, int right)
 
{
 
    int tmp,i;
 
    if(left>=right)
 
        return;
 
    tmp=a[right];
 
    for(i=right;i>left;i--)
 
        a[i]=a[i-1];
 
    a[left]=tmp;
 
}
 
void circular_left(int a[],int left, int right)
 
{
 
    int tmp,i;
 
    if(left>=right)
 
        return;
 
    tmp=a[left];
 
    for(i=left;i<right;i++)
 
        a[i]=a[i+1];
 
    a[right]=tmp;
 
}
 
void Perm(int a[],int k,int m)
 
{
 
    int i;
 
    if(k==m)
 
    {
 
        for(i=0;i<m;i++)
 
        {
 
            printf("%d,",a[i]);
 
        }
 
        printf("%d\n",a[i]);
 
    }
 
    else
 
    {
 
        for(i=k;i<=m;i++)
 
        {
 
            Swap(&a[k],&a[i]);
 
            circular_right(a,k+1,i);
 
            Perm(a,k+1,m);
 
            circular_left(a,k+1,i);
 
            Swap(&a[k],&a[i]);
 
        }
 
    }
 
}
 
int main()
 
{
 
    int i,n,array[10];
 
    scanf("%d",&n);
 
    for(i=0;i<n;i++)
 
    {
 
        scanf("%d",&array[i]);
 
    }
 
    Perm(array,0,n-1);
 
    return 0;
 
}
