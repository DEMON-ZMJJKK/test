#include<stdio.h>
#include<stdlib.h>
int b[1001],q[1001];
int main()
{
    int i,k,n,sum;
    while(scanf("%d",&n)!=EOF)
    {
        for(i=1;i<=n;i++)
        {
            scanf("%d",&b[i]);
        }
        q[1]=b[1];
        for(k=2;k<=n;k++)
        {
            sum=0;
            for(i=1;i<=k;i++)
            {
                if(b[i]<b[k]&&sum<q[i])
                {
                    sum=q[i];
                }
            }
            q[k]=sum+b[k];
        }
        sum=0;
        for(i=1;i<=n;i++)
        {
            if(q[i]>sum)sum=q[i];
        }
        printf("%d\n",sum);
    }
    return 0;
}
