#include <stdio.h>
void sort(int *a,int n,int flag)
{
    int t,i,j;
    if(flag)
    {
        for(i=0;i<n;i++)
        {
            for(j=0;j<n-i-1;j++)
            {
                if(a[j]>a[j+1])
                {
                    t=a[j];
                    a[j]=a[j+1];
                    a[j+1]=t;
                }
            }
        }
    }
    else
    {
        for(i=0;i<n;i++)
        {
            for(j=0;j<n-i-1;j++)
            {
                if(a[j]<a[j+1])
                {
                    t=a[j];
                    a[j]=a[j+1];
                    a[j+1]=t;
                }
            }
        }
    }
}
int main()
{
    int n,m,i,ans;
    int a[201],dis[201];
    while(scanf("%d%d",&n,&m)!=EOF)
    {
        for(i=0;i<n;i++)
        {
        scanf("%d",&a[i]);
        }
        if(n<=m)printf("%d\n",n);
        else
        {
            sort(a,n,1);
            for(i=0;i<n-1;i++)
            {
            dis[i]=a[i+1]-a[i]-1;
            }
            sort(dis,n-1,0);
            ans=a[n-1]-a[0]+1;
            for(i=0;i<m-1;i++)
            {
            ans-=dis[i];
            }
            printf("%d\n",ans);
        }
    }
    return 0;
}
