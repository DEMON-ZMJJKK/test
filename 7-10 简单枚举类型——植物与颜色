#include <stdio.h>
#include <string.h>
enum Color {
    RED,
    ORANGE,
    YELLOW,
    GREEN,
    BLUE,
    VIOLET,
    UNKNOWN 
};

int main() {
    int n;
    char inputColor[31];
    scanf("%d", &n);
    
    while (n--) {
        scanf("%s", inputColor);
        if (strcmp(inputColor, "red") == 0) {
            printf("Rose are red.\n");
        } else if (strcmp(inputColor, "orange") == 0) {
            printf("Poppies are orange.\n");
        } else if (strcmp(inputColor, "yellow") == 0) {
            printf("Sunflower are yellow.\n");
        } else if (strcmp(inputColor, "green") == 0) {
            printf("Grass are green.\n");
        } else if (strcmp(inputColor, "blue") == 0) {
            printf("Bluebells are blue.\n");
        } else if (strcmp(inputColor, "violet") == 0) {
            printf("Violets are violet.\n");
        } else {
            printf("I don't know about the color %s.\n", inputColor);
        }
    }

    return 0;
}
