#include <stdio.h>
int a[1000001],t;
void sort(int l,int r)
{
    t=a[l];
    int i=l,j=r;
    if(l>=r)return;
    while(i<j)
    {
        while(a[j]<=t&&i<j)j--;
        a[i]=a[j];
        while(a[i]>=t&&i<j)i++;
        a[j]=a[i];
    }
    a[i]=t;
    sort(l,i-1);
    sort(i+1,r);
}
int main()
{
    int i,m,n,x,y,ans=0;
    while(scanf("%d %d",&n,&m)!=EOF)
    {
        for(i=0;i<n;i++)
        {
            scanf("%d%d",&x,&y);
            a[i]=y-x;
        }
        sort(0,n-1);
        for(i=0;i<m;i++)
        {
            ans+=a[i];
        }
        printf("%d\n",ans);
    }
    return 0;
}
