#include<stdio.h>
#include<stdlib.h>
int main()
{
    int i,j;
    int *array=NULL;
    scanf("%d",&i);
    array=(int*)malloc(i*sizeof(int));
    for(j=0;j<i;j++)
    {
        scanf("%d",&array[j]);
    }
    for(j=i-1;j>=0;j--)
    {
        if(j==i-1)
            printf("%d",array[j]);
        else
            printf(" %d",array[j]);
    }
    return 0;
}
