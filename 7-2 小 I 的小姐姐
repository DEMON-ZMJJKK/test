#include <stdio.h>
#include <stdlib.h>
struct
{
    int w1;
    int w2;
    int w3;
}a[5000];
int main()
{
    int b[5000];
    int t,i,max,num;
    while(~scanf("%d",&t))
    {
        for (i=0;i<t;i++)
        {
            scanf("%d %d %d",&a[i].w1,&a[i].w2,&a[i].w3);
        }
        for (i=0;i<t;i++)
        {
            b[i]=0.7*a[i].w1+0.2*a[i].w2+0.1*a[i].w3;
        }
        max=-1;num=0;
        for (i=0;i<t;i++)
        {
            if(b[i]>max)
            {
                max=b[i];
                num=i;
            }
        }
        printf("%d\n",num);
    }
    return 0;
}


