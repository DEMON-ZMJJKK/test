#include<stdio.h>
#define MAX_NUM 100
int D[MAX_NUM+10][MAX_NUM+10];
int a[MAX_NUM+10][MAX_NUM+10];
int N;
int main()
{
    int i,j;
    scanf("%d",&N);
    for(i=1;i<=N;i++)
    {
        for(j=1;j<=i;j++)
        {
            scanf("%d",&D[i][j]);
        }
    }
    for(j=1;j<=N;j++)
    {
        a[N][j]=D[N][j];
    }
    for(i=N;i>1;i--)
    {
        for(j=1;j<=i;j++)
        {
            if(a[i][j]>a[i][j+1])a[i-1][j]=a[i][j]+D[i-1][j];
            else a[i-1][j]=a[i][j+1]+D[i-1][j];
        }
    }
    printf("%d\n",a[1][1]);
    return 0;
}
