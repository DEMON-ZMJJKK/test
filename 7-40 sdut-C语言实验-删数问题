#include <stdio.h>
 
#include<string.h>
 
int main()
 
{
 
    char s[101];
 
    int n,m,i,j;
 
    while(scanf("%s%d",s,&n)!=EOF)
 
    {
 
        m=strlen(s);
 
        while(n--)
 
        {
 
            i=0;
 
            while(s[i]<=s[i+1]&&i+1<m)
 
            {
 
                i++;
 
            }
 
            if(i!=m-1)
 
            {
 
             for(j=i;j<m;j++)
 
            {
 
                s[j]=s[j+1];
 
            }
 
            }
 
            m--;
 
        }
 
        i=0;
 
        while(s[i]=='0'&&i<m)i++;
 
        if(i==m) printf("0\n");
 
        else
 
        {
 
            for(j=i;j<m;j++)
 
            printf("%c",s[j]);
 
            printf("\n");
 
        }
 
    }
 
    return 0;
 
}
