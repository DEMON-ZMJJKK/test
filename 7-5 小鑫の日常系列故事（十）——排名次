#include<stdio.h>
#include<string.h>
struct node
{
    int s;
    char name[21];
} p[101],t;
int main()
{
    int n;
    int j,i;
    scanf("%d",&n);
    for(i=0; i<n; i++)
    {
        scanf("%s",p[i].name);
        scanf("%d",&p[i].s);
    }
    for(i=0; i<n-1; i++)
    {
        for(j=0; j<n-1-i; j++)
        {
            if(p[j].s<p[j+1].s)
            {
                t=p[j];
                p[j]=p[j+1];
                p[j+1]=t;
            }
        }
    }
    for(i=0; i<n; i++)
    {
        printf("%s %d\n",p[i].name,p[i].s);
    }
    return 0;
}
